{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022"], "types": ["@cloudflare/workers-types", "node"],
    "strict": true, "allowJs": true, "checkJs": false, "noEmit": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["server/**/*.ts", "shared/**/*.js", "tests/**/*.ts"]
}
