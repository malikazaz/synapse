{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synapse-ccs",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*", "/oauth/*", "/.well-known/*", "/mcp", "/authorize"]},
  "d1_databases": [{"binding": "DB", "database_name": "synapse", "database_id": "local-only", "migrations_dir": "migrations"}],
  "kv_namespaces": [{"binding": "OAUTH_KV", "id": "local-only"}],
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "OWNER_EMAIL": "owner@example.com",
    "SPREADSHEET_ID": "REPLACE_WITH_YOUR_SPREADSHEET_ID",
    "SHEETS_ENABLED": "false"
  },
  "observability": {"enabled": false}
}
